rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- سیکیورٹی ہیلپرز ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         request.auth.token.email == "karobarisaathi@gmail.com");
    }

    // --- ایپ سیٹنگز ---
    match /settings/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userData/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- صارفین کا ڈیٹا (کھاتہ، ٹرانزیکشنز، انوینٹری) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /professions/{professionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /inventory_items/{itemId} {
        allow read: if isSignedIn(); // لاگ ان صارفین دیکھ سکتے ہیں
        allow write: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read, delete, update: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
      }
    }

    // --- پرائس ٹریکر (Price Tracker) ---
    match /price_reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /price_alerts/{alertId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- مارکیٹ پلیس سیکیورٹی لاگز اور رپورٹنگ ---
    match /ad_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // کوئی بھی لاگ تبدیل نہیں کر سکتا
    }

    match /contact_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /favorites/{favId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // --- کاریگر پروفائلز (Artisan Profiles) ---
    match /artisans/{artisanId} {
      allow read: if isSignedIn();
      allow write: if isOwner(artisanId) || isAdmin();

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      match /work_orders/{orderId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    match /artisan_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.customerUid == request.auth.uid || resource.data.artisanUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerUid == request.auth.uid || resource.data.artisanUid == request.auth.uid);
    }

    // --- چیٹ سسٹم (Chat System) ---
    match /chat_rooms/{chatId} {
      // رولز کو لسٹ (Array) کی بنیاد پر سیٹ کیا گیا ہے تاکہ Query صحیح کام کرے
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
        allow update: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      }
    }

    // --- ویریفیکیشن سسٹم (سخت سیکیورٹی کے ساتھ) ---
    match /verification_requests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.adminNote == null;

      allow update: if isAdmin()
          || (isOwner(userId)
              && resource.data.status != 'approved' // منظور شدہ درخواست یوزر نہیں بدل سکتا
              && request.resource.data.status == 'pending'
              && request.resource.data.adminNote == null);

      allow delete: if isOwner(userId) && resource.data.status != 'approved';
    }

    // --- گلوبل سرچ سپورٹ ---
    match /{path=**}/inventory_items/{itemId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/work_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid);
    }
  }
}