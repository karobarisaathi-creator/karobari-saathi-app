rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- سیکیورٹی ہیلپرز ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         request.auth.token.email == "karobarisaathi@gmail.com");
    }

    // --- ایپ سیٹنگز ---
    match /settings/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userData/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- صارفین کا ڈیٹا (کھاتہ، ٹرانزیکشنز) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /professions/{professionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read, delete, update: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
      }
      match /favorite_artisans/{artisanId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- بزنس چیٹ سسٹم ---
    match /business_chats/{chatId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/business_chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // --- کاریگر پروفائلز (Artisan Profiles) ---
    match /artisans/{artisanId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(artisanId);

      allow update: if isSignedIn() && (
        isOwner(artisanId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workCount', 'updatedAt', 'availability', 'rating', 'totalReviews', 'showWhatsApp', 'showPhone'])
      );

      match /work_orders/{orderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == artisanId || resource.data.customerId == request.auth.uid);
        allow create: if isSignedIn() &&
          (request.resource.data.artisanId == artisanId &&
           request.resource.data.customerId == request.auth.uid);
        allow update: if isAdmin() ||
          (request.auth.uid == artisanId &&
            request.resource.data.artisanId == resource.data.artisanId &&
            request.resource.data.customerId == resource.data.customerId &&
            ((resource.data.status == 'negotiating' && request.resource.data.status == 'quoted') ||
             (resource.data.status == 'confirmed' && request.resource.data.status == 'in_progress') ||
             (resource.data.status == 'in_progress' && request.resource.data.status == 'completed'))) ||
          (request.auth.uid == resource.data.customerId &&
            resource.data.status == 'completed' &&
            request.resource.data.status == 'rated' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review', 'isRated', 'ratedAt', 'status'])) ||
          (request.auth.uid == resource.data.customerId &&
            (resource.data.status == 'negotiating' || resource.data.status == 'quoted') &&
            request.resource.data.status == 'confirmed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerAgreed', 'customerAcceptedTerms', 'agreedAt', 'status']));
        allow delete: if isAdmin() || request.auth.uid == artisanId || resource.data.customerId == request.auth.uid;
      }

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

    }

    match /artisan_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.customerUid == request.auth.uid || resource.data.artisanUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerUid == request.auth.uid || resource.data.artisanUid == request.auth.uid);
    }

    // --- جاب پوسٹنگ سسٹم (Jobs) ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.customerId &&
          request.resource.data.customerId == resource.data.customerId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.customerId || isAdmin());

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.artisanId == request.auth.uid;
        allow update: if isAdmin() ||
          (isSignedIn() && request.auth.uid ==
            get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')) ||
          (isSignedIn() && request.auth.uid == resource.data.artisanId &&
            request.resource.data.artisanId == resource.data.artisanId &&
            request.resource.data.jobId == resource.data.jobId &&
            request.resource.data.status == resource.data.status);
        allow delete: if isAdmin() ||
          (isSignedIn() && request.auth.uid ==
            get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId);
      }
    }

    // --- آڈٹ لاگز ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- ویریفیکیشن سسٹم ---
    match /verification_requests/{userId} {
      allow list: if isAdmin();
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';

      allow update: if isAdmin()
          || (isOwner(userId)
              && resource.data.status != 'approved'
              && request.resource.data.status == 'pending');

      allow delete: if isOwner(userId) && resource.data.status != 'approved';
    }

    // --- گلوبل سرچ سپورٹ ---
    match /{path=**}/work_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid);
    }
  }
}
