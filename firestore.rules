rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ HELPER FUNCTIONS ═══
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{userId} document موجود ہونا اور deactivated نہ ہونا لازم ہے
    function isActiveUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId))
            .data.get('isDeactivated', false) != true;
    }

    function isActiveOwner(userId) {
      return isOwner(userId) && isActiveUser(userId);
    }

    function ownsLegacyUserData(docId) {
      return isSignedIn() && (
        (request.auth.token.phone_number != null
          && docId == request.auth.token.phone_number)
        || (request.auth.token.email_verified == true
          && request.auth.token.email != null
          && docId == request.auth.token.email)
      );
    }

    function validMarketplaceListing(data, listingId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'sellerName', 'phoneNumber', 'phoneShared', 'title',
          'description', 'category', 'condition', 'area', 'price',
          'isNegotiable', 'imageUrls', 'imagePaths', 'status', 'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'sellerName', 'phoneNumber', 'phoneShared', 'title',
          'description', 'category', 'condition', 'area', 'price',
          'isNegotiable', 'imageUrls', 'imagePaths', 'status', 'createdAt',
          'updatedAt'
        ])
        && data.id == listingId
        && data.ownerId is string
        && data.sellerName is string
        && data.sellerName.size() > 0
        && data.sellerName.size() <= 80
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 7
        && data.phoneNumber.size() <= 30
        && data.phoneNumber.matches('^[+0-9 ()-]+$')
        && data.phoneNumber.matches('.*[0-9].*')
        && data.phoneShared == true
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 1500
        && data.category in [
          'electronics', 'home', 'fashion', 'tools', 'vehicles', 'other'
        ]
        && data.condition in ['new', 'used']
        && data.area is string
        && data.area.size() > 0
        && data.area.size() <= 100
        && data.price is number
        && data.price >= 0
        && data.isNegotiable is bool
        && data.imageUrls is list
        && data.imageUrls.size() <= 5
        && data.imagePaths is list
        && data.imagePaths.size() == data.imageUrls.size()
        && data.status in ['active', 'sold', 'hidden']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ═══ SETTINGS ═══
    match /settings/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /userData/{docId} {
      allow read, write: if isSignedIn()
        && isActiveOwner(request.auth.uid)
        && (docId == request.auth.uid || ownsLegacyUserData(docId));
    }

    // ═══ BACKUPS ═══
    match /backups/{userId} {
      allow read, write: if isActiveOwner(userId);

      match /{backupPath=**} {
        allow read, write: if isActiveOwner(userId);
      }
    }

    // ═══ PUBLIC PROFILES ═══
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isActiveOwner(userId)
        && request.resource.data.uid == userId
        && (
          (
            request.auth.token.phone_number == null
            && !request.resource.data.keys().hasAny(['phoneNumber'])
          )
          || (
            request.auth.token.phone_number is string
            && request.resource.data.keys().hasAll(['phoneNumber'])
            && request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber == request.auth.token.phone_number
          )
        )
        && request.resource.data.keys().hasOnly([
          'uid', 'phoneNumber', 'displayName', 'photoURL',
          'profession', 'businessAddress', 'shopName', 'photoUrl'
        ]);
      allow delete: if isOwner(userId);
    }

    // ═══ PUBLIC SHOPS ═══
    match /public_shops/{shopId} {
      allow read: if isSignedIn();
      allow create, delete: if isActiveOwner(shopId);
      allow update: if isActiveOwner(shopId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'communityRating',
          'communityReviewCount',
          'communityRatingTotal'
        ]);

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isActiveOwner(shopId);
      }

      match /reviews/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isActiveOwner(userId)
          && request.auth.uid == userId
          && request.auth.uid != shopId
          && request.resource.data.keys().hasAll([
            'userId', 'rating', 'comment', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'userId', 'rating', 'comment', 'updatedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.updatedAt == request.time;
        allow delete: if isActiveOwner(userId)
          && request.auth.uid == userId
          && request.auth.uid != shopId;
      }
    }

    // ═══ MARKETPLACE ═══
    match /marketplace_listings/{listingId} {
      allow read: if isSignedIn()
        && (resource.data.status != 'hidden'
          || isActiveOwner(resource.data.ownerId));
      allow create: if isSignedIn()
        && isActiveOwner(request.auth.uid)
        && validMarketplaceListing(request.resource.data, listingId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveOwner(resource.data.ownerId)
        && validMarketplaceListing(request.resource.data, listingId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isActiveOwner(resource.data.ownerId);

      match /reports/{reporterId} {
        allow read: if isOwner(
          get(/databases/$(database)/documents/marketplace_listings/$(listingId))
            .data.ownerId
        ) || isOwner(reporterId);
        allow create: if isActiveOwner(request.auth.uid)
          && reporterId == request.auth.uid
          && get(/databases/$(database)/documents/marketplace_listings/$(listingId))
            .data.ownerId != request.auth.uid
          && request.resource.data.keys().hasAll([
            'reporterId', 'reason', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'reporterId', 'reason', 'createdAt'
          ])
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ═══ USERS (private data) ═══
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['isDeactivated']);
      allow update: if isOwner(userId)
        && isActiveUser(userId)
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['isDeactivated'])
          || (request.resource.data.isDeactivated == true
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['isDeactivated', 'deactivatedAt', 'restoreDeadline']))
        );
      allow delete: if false;

      match /accounts/{accountId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /categories/{categoryId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /professions/{professionId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /transactions/{transactionId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /stock_items/{itemId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /stock_movements/{movementId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, delete, update: if isActiveOwner(userId);
        allow create: if isSignedIn()
          && isActiveUser(userId)
          && isActiveOwner(request.auth.uid)
          && request.resource.data.keys().hasAll(['data'])
          && request.resource.data.data is map
          && request.resource.data.data.get('senderUid', '') == request.auth.uid;

        match /reports/{reporterId} {
          allow create: if isActiveOwner(userId)
            && reporterId == request.auth.uid
            && request.resource.data.keys().hasAll([
              'reporterUid', 'reason', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'reporterUid', 'reason', 'createdAt'
            ])
            && request.resource.data.reporterUid == request.auth.uid
            && request.resource.data.reason == 'user_reported'
            && request.resource.data.createdAt == request.time;
          allow read, update, delete: if false;
        }
      }
    }
  }
}