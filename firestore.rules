rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- سیکیورٹی ہیلپرز ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         request.auth.token.email == "karobarisaathi@gmail.com");
    }

    // --- ایپ سیٹنگز ---
    match /settings/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userData/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- صارفین کا ڈیٹا (کھاتہ، ٹرانزیکشنز) ---
    match /backups/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /professions/{professionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /stock_items/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /stock_movements/{movementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read, delete, update: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
      }
    }

    // --- آڈٹ لاگز ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- ویریفیکیشن سسٹم ---
    match /verification_requests/{userId} {
      allow list: if isAdmin();
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';

      allow update: if isAdmin()
          || (isOwner(userId)
              && resource.data.status != 'approved'
              && request.resource.data.status == 'pending');

      allow delete: if isOwner(userId) && resource.data.status != 'approved';
    }

    // --- گلوبل سرچ سپورٹ ---
  }
}
