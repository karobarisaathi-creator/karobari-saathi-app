rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- سیکیورٹی ہیلپرز ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         request.auth.token.email == "karobarisaathi@gmail.com");
    }

    // --- ایپ سیٹنگز ---
    match /settings/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userData/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- صارفین کا ڈیٹا (کھاتہ، ٹرانزیکشنز) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /professions/{professionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read, delete, update: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
      }
      match /favorite_artisans/{artisanId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- کاریگر پروفائلز (Artisan Profiles) ---
    match /artisans/{artisanId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(artisanId);

      allow update: if isSignedIn() && (
        isOwner(artisanId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workCount', 'updatedAt', 'availability', 'rating', 'totalReviews', 'showWhatsApp', 'showPhone'])
      );

      match /work_orders/{orderId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == artisanId || resource.data.customerId == request.auth.uid);
        allow create: if isSignedIn() &&
          (request.resource.data.artisanId == artisanId &&
           (request.auth.uid == request.resource.data.customerId || request.auth.uid == request.resource.data.artisanId) &&
           request.resource.data.artisanId != request.resource.data.customerId);
        allow update: if isAdmin() ||
          // Artisan: Full control over their work orders (except changing customer feedback)
          (request.auth.uid == artisanId &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'review', 'isRated', 'ratedAt'])) ||
          // Customer: Can update negotiation fields and provide rating
          (request.auth.uid == resource.data.customerId && (
             // Case 1: Updating rating (only if status is completed and not already rated)
             (resource.data.status == 'completed' && request.resource.data.status == 'rated' && !resource.data.isRated && request.resource.data.isRated == true) ||
             // Case 2: General negotiation/chat updates
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'review', 'isRated', 'ratedAt', 'artisanAgreed', 'artisanAcceptedTerms']))
          ));

        allow delete: if isAdmin() || request.auth.uid == artisanId || resource.data.customerId == request.auth.uid;

        match /negotiations/{messageId} {
          allow read, list: if isSignedIn() &&
            (request.auth.uid == artisanId ||
             request.auth.uid == get(/databases/$(database)/documents/artisans/$(artisanId)/work_orders/$(orderId)).data.customerId);
          allow create: if isSignedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            (request.auth.uid == artisanId ||
             request.auth.uid == get(/databases/$(database)/documents/artisans/$(artisanId)/work_orders/$(orderId)).data.customerId);
          allow update: if isSignedIn() &&
            (request.auth.uid == artisanId ||
             request.auth.uid == get(/databases/$(database)/documents/artisans/$(artisanId)/work_orders/$(orderId)).data.customerId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
          allow delete: if isSignedIn() &&
            (request.auth.uid == artisanId ||
             request.auth.uid == get(/databases/$(database)/documents/artisans/$(artisanId)/work_orders/$(orderId)).data.customerId);
        }
      }

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

    }

    match /artisan_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.customerUid == request.auth.uid || resource.data.artisanUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.artisanUid != request.resource.data.customerUid;
      allow update: if isSignedIn() &&
        request.resource.data.artisanUid != request.resource.data.customerUid &&
        (resource.data.customerUid == request.auth.uid || resource.data.artisanUid == request.auth.uid);
    }

    // --- جاب پوسٹنگ سسٹم (Jobs) ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.customerId &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'location', 'categories',
            'estimatedBudget', 'deadline', 'images', 'clarifications',
            'detailedScope', 'scopeOfWork', 'exclusions', 'isComplex',
            'estimatedDays', 'requiresHeightWork', 'requiresSpecialTools',
            'latitude', 'longitude', 'timeIn', 'timeOut', 'status', 'website',
            'budgetUnit', 'durationUnit', 'companyName'
          ]));
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.customerId || isAdmin());

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.artisanId == request.auth.uid &&
          request.resource.data.artisanId != get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId &&
          get(/databases/$(database)/documents/artisans/$(request.auth.uid)).data.isActive == true;
        allow update: if isAdmin() ||
          (isSignedIn() && request.auth.uid ==
            get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')) ||
          (isSignedIn() && request.auth.uid == resource.data.artisanId &&
            request.resource.data.artisanId == resource.data.artisanId &&
            request.resource.data.jobId == resource.data.jobId &&
            request.resource.data.status == resource.data.status);
        allow delete: if isAdmin() ||
          (isSignedIn() && request.auth.uid ==
            get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId);

        match /negotiations/{messageId} {
          allow read: if isSignedIn() &&
            (request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId ||
             request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)/bids/$(bidId)).data.artisanId);
          allow create: if isSignedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            (request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId ||
             request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)/bids/$(bidId)).data.artisanId);
          allow update: if isSignedIn() &&
            (request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId ||
             request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)/bids/$(bidId)).data.artisanId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
          allow delete: if false; // Keeping delete false if not needed, or add if necessary
        }
      }
    }

    // --- آڈٹ لاگز ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- ویریفیکیشن سسٹم ---
    match /verification_requests/{userId} {
      allow list: if isAdmin();
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';

      allow update: if isAdmin()
          || (isOwner(userId)
              && resource.data.status != 'approved'
              && request.resource.data.status == 'pending');

      allow delete: if isOwner(userId) && resource.data.status != 'approved';
    }

    // --- گلوبل سرچ سپورٹ ---
    match /{path=**}/work_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid);
    }
  }
}
