rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rule for App Settings (Version Control)
    match /settings/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rule for the userData collection
    match /userData/{docId} {
      allow read, create, write: if isAuthenticated();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Subcollections
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
      match /professions/{professionId} {
        allow read, write: if isOwner(userId);
      }
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /inventory_items/{itemId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Notifications: Owner can manage, but any user can create.
      match /notifications/{notificationId} {
        allow read, delete, update: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // --- PRICE TRACKER RULES ---

    // Price Reports: Anyone can read, only logged in users can report
    match /price_reports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false; // Reports shouldn't be edited normally
    }

    // Price Alerts: Users can manage their own alerts
    match /price_alerts/{alertId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- NEW COLLECTIONS ---

    // Verification Requests: Users can only manage their own
    match /verification_requests/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Reviews: Anyone can read, logged in users can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Ad Reports: Authenticated users can create
    match /ad_reports/{reportId} {
      allow read: if false; // Only admins (via console)
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Favorites: Users can manage their own favorites
    match /favorites/{favId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // --- COLLECTION GROUP RULES ---
    // Required for Global Marketplace
    match /{path=**}/inventory_items/{itemId} {
      allow read: if isAuthenticated();
    }
  }
}